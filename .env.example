# Local Express API and Vite frontend settings
PORT=5001
FRONTEND_URL=http://localhost:5173

# Server-side Supabase configuration (publishable key only; RLS remains enabled)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Browser-facing Supabase configuration. These are public client values, not secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side Gemini key pool. Add or remove comma-separated keys; never use a VITE_ prefix.
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4,your_key_5,your_key_6,your_key_7

# Backward-compatible fallback for existing single-key setups.
GEMINI_API_KEY=replace_me
